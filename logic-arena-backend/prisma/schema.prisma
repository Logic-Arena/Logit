generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id          Int             @id @default(autoincrement())
  provider         String
  provider_user_id String?
  login_id         String?         @unique
  password         String?
  email            String?         @unique
  name             String
  profile_image    String?
  created_at       DateTime        @default(now())
  stats            UserStats?
  debate_histories DebateHistory[]
}

model UserStats {
  user_id       Int      @id
  tier          String   @default("브론즈 5")
  rank_point    Int      @default(0)
  score_average Float    @default(0)
  total_games   Int      @default(0)
  win_count     Int      @default(0)
  badges        Json     @default("[]")
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [user_id])
}

model DebateHistory {
  id         Int      @id @default(autoincrement())
  user_id    Int
  topic      String
  position   String
  score      Int      @default(0)
  logic      Int      @default(0)
  evidence   Int      @default(0)
  persuasion Int      @default(0)
  rebuttal   Int      @default(0)
  advice     String?
  result     String   @default("draw")
  played_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [user_id])
}

model CommunityTopic {
  id             Int             @id @default(autoincrement())
  question       String
  category       String
  badge          String?
  pro_votes      Int             @default(0)
  con_votes      Int             @default(0)
  expires_at     DateTime
  created_at     DateTime        @default(now())
  activated_at   DateTime?       // 주제 활성화 시각 (NEW 배지 계산용)
  slot           String          @default("A") // A/B/C 슬롯
  category_fixed String          @default("사회") // 슬롯별 고정 카테고리
  display_order  Int             @default(0) // 순서
  status         String          @default("active") // active/pending/closed
  votes          CommunityVote[]
}

model CommunityVote {
  id         Int            @id @default(autoincrement())
  topic_id   Int
  user_id    Int
  vote       String
  created_at DateTime       @default(now())
  topic      CommunityTopic @relation(fields: [topic_id], references: [id])

  @@unique([topic_id, user_id])
}
